# IDE
.idea/

# Cloned repos — directories are named after the plural of the repo type
# Add a new line here whenever a new type is introduced

# Skill catalogue — regenerated by session-init from .ai/skills/ frontmatter
CATALOGUE.md

# Build artefacts — root-level binary only, not the cmd/ocs-testbench source dir
/ocs-testbench
cmd/ocs-testbench/build/

# Frontend test coverage
web/coverage/

# Claude Code internals
.claude/scheduled_tasks.lock

# Runtime AI settings override — written next to config.yaml, holds the API key
cmd/ocs-testbench/ai-settings.json

# Generated Wails JS bindings (regenerated by `wails build`)
web/wailsjs/

# Frontend build cache
web/package.json.md5

# understand-anything knowledge-graph output
.understand-anything/
